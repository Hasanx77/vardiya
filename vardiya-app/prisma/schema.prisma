// Prisma şeması — Vardiya
// SQLite (yerel geliştirme). Yayına alırken Postgres'e çevrilebilir.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// İşletme (çok işletmeye hazır: her kayıt bir businessId taşır)
model Business {
  id        String   @id @default(cuid())
  name      String   @default("İşletmem")
  createdAt DateTime @default(now())

  employees      Employee[]
  shiftTemplates ShiftTemplate[]
  assignments    Assignment[]
  announcements  Announcement[]
  dayNotes       DayNote[]
  openShifts     OpenShift[]
  tasks          Task[]
}

model Employee {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String   @default("")
  role       String   @default("Personel")
  color      String   @default("sky")
  hourlyWage Float    @default(0)
  annualLeaveDays Int @default(14)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  requests    TimeOffRequest[]
  availabilities Availability[]
}

model ShiftTemplate {
  id         String @id @default(cuid())
  businessId String
  name       String
  start      String
  end        String
  color      String @default("sky")
  /** Bu vardiyada hedeflenen en az kişi sayısı (0 = hedef yok) */
  minStaff   Int    @default(0)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  openShifts  OpenShift[]
}

model Assignment {
  id              String @id @default(cuid())
  businessId      String
  employeeId      String
  shiftTemplateId String
  date            String // YYYY-MM-DD

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

// Personelin izin / vardiya değişimi talebi
model TimeOffRequest {
  id         String   @id @default(cuid())
  employeeId String
  date       String // YYYY-MM-DD
  type       String   @default("izin") // izin | degisim
  note       String   @default("")
  status     String   @default("pending") // pending | approved | rejected
  /** Vardiya değişiminde hedef personel (opsiyonel) */
  targetEmployeeId String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// Patronun ekibe duyurusu
model Announcement {
  id         String   @id @default(cuid())
  businessId String
  message    String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// Personelin "müsait değilim" işaretlediği günler
model Availability {
  id         String   @id @default(cuid())
  employeeId String
  date       String // YYYY-MM-DD
  note       String   @default("")
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

// Gün bazlı notlar (ör. "canlı müzik", "stok sayımı")
model DayNote {
  id         String   @id @default(cuid())
  businessId String
  date       String // YYYY-MM-DD
  note       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

// Açık vardiya (havuz): personelin sahiplenebileceği boş vardiya
model OpenShift {
  id              String   @id @default(cuid())
  businessId      String
  shiftTemplateId String
  date            String // YYYY-MM-DD
  note            String   @default("")
  createdAt       DateTime @default(now())

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)
}

// Günlük görev (açılış/kapanış kontrol listesi)
model Task {
  id         String   @id @default(cuid())
  businessId String
  title      String
  createdAt  DateTime @default(now())

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  completions TaskCompletion[]
}

model TaskCompletion {
  id     String @id @default(cuid())
  taskId String
  date   String // YYYY-MM-DD

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
}
