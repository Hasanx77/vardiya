// Prisma şeması — Vardiya
// SQLite (yerel geliştirme). Yayına alırken Postgres'e çevrilebilir.
// Model: işveren yönetir; personel yalnızca görüntüler (aksiyon almaz).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Kullanıcı (işletme sahibi) — e-posta + şifre ile giriş yapar.
// Şifre asla düz metin saklanmaz: scrypt ile tuzlanmış özet (hash) tutulur.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  /** Görünen ad (e-posta yerine). Küçük harf, 3-24 karakter, tekil. */
  username     String?   @unique
  /** E-posta doğrulandıysa dolu. Doğrulanmamış hesaplar giriş yapabilir. */
  emailVerifiedAt DateTime?
  /** Google ile giriş: Google'ın kullanıcı kimliği (sub). Bağlıysa dolu. */
  googleId     String?   @unique
  /** Başlangıç adımları tamamlandı mı? (ad + marka + mesai saatleri) */
  onboardedAt  DateTime?
  /** Şifre değişince artırılır; eski oturum çerezleri geçersizleşir. */
  sessionVersion Int     @default(0)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  business Business?
  resets   PasswordReset[]
}

/// Şifre sıfırlama anahtarı. Ham anahtar yalnızca e-postada; burada SHA-256 özeti durur.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// İşletme
model Business {
  id        String   @id @default(cuid())
  name      String   @default("İşletmem")
  createdAt DateTime @default(now())

  // Standart mesai saatleri — vardiya şablonları bu saatlerden türetilir.
  openTime  String   @default("09:00")
  closeTime String   @default("23:00")

  // Sahibi: bir kullanıcı yalnızca kendi işletmesini görür (hesap izolasyonu).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employees      Employee[]
  shiftTemplates ShiftTemplate[]
  assignments    Assignment[]
  announcements  Announcement[]
  dayNotes       DayNote[]
  weekPlans      WeekPlan[]
}

model Employee {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String   @default("")
  role       String   @default("Personel")
  color      String   @default("sky")
  hourlyWage Float    @default(0)
  /** Yıllık izin hakkı (gün) — işveren belirler */
  annualLeaveDays Int @default(14)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments Assignment[]
}

model ShiftTemplate {
  id         String @id @default(cuid())
  businessId String
  name       String
  start      String
  end        String
  color      String @default("sky")
  /** Bölünmüş vardiya: ücretsiz aranın başlangıcı ("HH:MM"). Yoksa null. */
  breakStart String?
  /** Bölünmüş vardiya: ücretsiz aranın bitişi ("HH:MM"). Yoksa null. */
  breakEnd   String?
  /** Bu vardiyada hedeflenen en az kişi sayısı (0 = hedef yok) */
  minStaff   Int    @default(0)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments Assignment[]
}

model Assignment {
  id              String @id @default(cuid())
  businessId      String
  employeeId      String
  shiftTemplateId String
  date            String // YYYY-MM-DD

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

// İşverenin ekibe duyurusu (personel yalnızca okur)
model Announcement {
  id         String   @id @default(cuid())
  businessId String
  message    String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// Gün bazlı notlar (ör. "canlı müzik", "stok sayımı")
model DayNote {
  id         String   @id @default(cuid())
  businessId String
  date       String // YYYY-MM-DD
  note       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

/**
 * Haftalık planın **yayın durumu**.
 *
 * Kayıt varsa o hafta yayınlanmıştır: personel bağlantısı ve `.ics` takvimi
 * yalnızca yayınlanmış haftaların vardiyalarını gösterir. Kayıt yoksa hafta
 * taslaktır ve ekibe sızmaz.
 */
model WeekPlan {
  id          String   @id @default(cuid())
  businessId  String
  /** Haftanın pazartesi günü: "YYYY-MM-DD" */
  weekStart   String
  publishedAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, weekStart])
  @@index([businessId])
}
