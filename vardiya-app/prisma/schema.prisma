// Prisma şeması — Vardiya
// SQLite (yerel geliştirme). Yayına alırken Postgres'e çevrilebilir.
// Model: işveren yönetir; personel yalnızca görüntüler (aksiyon almaz).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// İşletme
model Business {
  id        String   @id @default(cuid())
  name      String   @default("İşletmem")
  createdAt DateTime @default(now())

  employees      Employee[]
  shiftTemplates ShiftTemplate[]
  assignments    Assignment[]
  announcements  Announcement[]
  dayNotes       DayNote[]
}

model Employee {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String   @default("")
  role       String   @default("Personel")
  color      String   @default("sky")
  hourlyWage Float    @default(0)
  /** Yıllık izin hakkı (gün) — işveren belirler */
  annualLeaveDays Int @default(14)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments Assignment[]
}

model ShiftTemplate {
  id         String @id @default(cuid())
  businessId String
  name       String
  start      String
  end        String
  color      String @default("sky")
  /** Bu vardiyada hedeflenen en az kişi sayısı (0 = hedef yok) */
  minStaff   Int    @default(0)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments Assignment[]
}

model Assignment {
  id              String @id @default(cuid())
  businessId      String
  employeeId      String
  shiftTemplateId String
  date            String // YYYY-MM-DD

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

// İşverenin ekibe duyurusu (personel yalnızca okur)
model Announcement {
  id         String   @id @default(cuid())
  businessId String
  message    String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// Gün bazlı notlar (ör. "canlı müzik", "stok sayımı")
model DayNote {
  id         String   @id @default(cuid())
  businessId String
  date       String // YYYY-MM-DD
  note       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}
