# Bu dosyayı `.env` olarak kopyalayıp doldur.

# Yerel geliştirme (SQLite):
DATABASE_URL="file:./dev.db"

# Yayın (Postgres örneği):
# DATABASE_URL="postgresql://kullanici:sifre@host:5432/vardiya?schema=public"

# --- Oturum güvenliği (ZORUNLU) ---
# Oturum çerezini imzalayan gizli anahtar. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="buraya-64-karakterlik-rastgele-deger"

# Eski ortak panel şifresi. Hesap sistemi geldikten sonra kullanılmıyor;
# yalnız eski kurulumlarla uyum için duruyor.
APP_PASSWORD="buraya-guclu-bir-sifre"

# Ziyaret sayacı ve gelen mesajlar kartını yalnızca bu e-posta adresli hesaplar görür.
# Birden fazla adres virgülle yazılabilir.
OWNER_EMAIL="hmum117413@gmail.com"

# --- Alan adı / ters vekil ---
# İzinli alan adları (virgülle). Host başlığı bunların dışındaysa kanonik ada çekilir.
SITE_HOSTS="zihnora.com.tr,www.zihnora.com.tr"
# HTTPS zorlamasını geçici olarak kapatmak için 0 yap (acil durum).
HTTPS_ZORLA="1"

# --- Cloudflare (opsiyonel) ---
# Cloudflare önüne geçildiğinde 1 yap: gerçek istemci IP'si cf-connecting-ip
# başlığından okunur. Cloudflare YOKKEN 1 yapma (başlık taklit edilebilir).
CLOUDFLARE_AKTIF="0"

# --- E-posta gönderimi (şifre sıfırlama, plan PDF, doğrulama) ---
# Boş bırakılırsa e-postalar .mail-outbox/ klasörüne yazılır (geliştirme kanalı).
SMTP_HOST="mail.zihnora.com.tr"
SMTP_PORT="465"
SMTP_USER="no-reply@zihnora.com.tr"
SMTP_PASS="posta-kutusu-sifresi"
MAIL_FROM="Vardiya <no-reply@zihnora.com.tr>"
MAIL_REPLY_TO="destek@zihnora.com.tr"

# --- Google ile giriş (isteğe bağlı) ---
# Dolu değilse "Google ile devam et" düğmesi hiç görünmez.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
