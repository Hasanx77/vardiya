# Bu dosyayı .env olarak kopyalayıp doldur.

# Yerel geliştirme (SQLite):
DATABASE_URL="file:./dev.db"

# Yayın (Postgres örneği):
# DATABASE_URL="postgresql://kullanici:sifre@host:5432/vardiya?schema=public"

# --- Panel şifre kapısı (ZORUNLU) ---
# Panelin açılması için gereken şifre. Boş bırakılırsa kapı hiç açılmaz.
APP_PASSWORD="buraya-guclu-bir-sifre"

# Oturum çerezini imzalayan gizli anahtar. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="buraya-64-karakterlik-rastgele-deger"
